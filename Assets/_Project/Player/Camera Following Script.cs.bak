using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class CameraFollowingScript : MonoBehaviour
{
    public Camera mainCamera = null;
    public Transform target = null;

    [Header("Position Settings")]
    public float distance = 5.0f;
    public float height = 5.0f;
    public float smoothTime = 0.2f; // Time for camera to reach target

    [Header("Rotation Settings")]
    public float rotationSmoothTime = 0.1f;
    public Vector3 offset = new Vector3(2.5f, 0, 0); // Side offset

    private Vector3 currentVelocity = Vector3.zero;

    void Start()
    {
        // 自动检测并赋值主摄像机，防止 NullReferenceException
        if (mainCamera == null)
        {
            mainCamera = Camera.main;
            if (mainCamera == null)
            {
                Debug.LogError("场景中找不到标签为 MainCamera 的相机！请在 Inspector 面板手动拖入相机。");
                return;
            }
        }

        if (target == null)
        {
            // 尝试找玩家
            GameObject player = GameObject.FindGameObjectWithTag("Player");
            if (player != null) target = player.transform;
            else target = transform;
        }

        // 初始位置对齐
        Vector3 targetPos = CalculateWantedPosition();
        mainCamera.transform.position = targetPos;
        mainCamera.transform.LookAt(target.position);
    }

    void LateUpdate()
    {
        if (target == null || mainCamera == null) return;

        // 1. 平滑移动位置 (使用 SmoothDamp 替代 Lerp，手感更丝滑)
        Vector3 wantedPosition = CalculateWantedPosition();
        mainCamera.transform.position = Vector3.SmoothDamp(
            mainCamera.transform.position, 
            wantedPosition, 
            ref currentVelocity, 
            smoothTime
        );

        // 2. 平滑旋转看向目标
        Quaternion targetRotation = Quaternion.LookRotation(target.position - mainCamera.transform.position);
        mainCamera.transform.rotation = Quaternion.Slerp(
            mainCamera.transform.rotation, 
            targetRotation, 
            Time.deltaTime / rotationSmoothTime
        );
    }

    private Vector3 CalculateWantedPosition()
    {
        // 计算目标位置：目标点 - 前向距离 + 高度偏移 + 侧向偏移
        return target.position - (Vector3.forward * distance) + (Vector3.up * height) + offset;
    }
}
